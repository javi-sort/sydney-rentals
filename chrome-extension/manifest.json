{
    "manifest_version": 3,
    "name": "Sydney Rental Tracker",
    "version": "1.0",
    "description": "Save and track rental listings from realestate.com.au and domain.com.au",
    "permissions": ["activeTab", "scripting"],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "https://www.realestate.com.au/*",
        "https://www.domain.com.au/*",
        "http://127.0.0.1:3000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Save this listing"
    },
    "content_scripts": [
        {
            "matches": ["https://www.realestate.com.au/*", "https://www.domain.com.au/*"],
            "js": ["content.js"]
        }
    ]
}
